NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SECRET_OR_SERVICE_ROLE_KEY
# Supabase Connect bölməsində Render-in IPv4 şəbəkəsi üçün Session Pooler (5432) seçin.
# Birbaşa bağlantı üçün Render şəbəkəsinin IPv6 dəstəyini yoxlayın.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres
# Generate at least 32 random bytes; never share with frontend. Keep stable once orders exist.
PICKUP_SECRET=REPLACE_WITH_A_STABLE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
